{
  "name": "hosted-saas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:calendar-sync": "node --no-warnings --experimental-strip-types --test tests/calendar-sync.test.mts",
    "test:time-card": "node --no-warnings --experimental-strip-types --test tests/time-card-response-parser.test.mts",
    "test:missing-punch": "node --no-warnings --experimental-strip-types --test tests/time-card-missing-punch.test.mts",
    "test": "npm run test:calendar-sync && npm run test:time-card && npm run test:missing-punch && npm run test:public && npm run test:auth && npm run test:db && npm run test:square-callback && npm run test:database-date && npm run test:time-card-disconnect && npm run test:tcm-delivery",
    "typecheck": "next typegen && tsc --noEmit",
    "build:public": "node scripts/build-public-site.mjs",
    "test:public": "node --test tests/public-site-artifact.test.mjs",
    "test:auth": "node --no-warnings --experimental-strip-types --test tests/auth-config.test.mts",
    "test:db": "node --no-warnings --experimental-strip-types --test tests/db-config.test.mts",
    "test:square-callback": "node --no-warnings --experimental-strip-types --test tests/square-callback.test.mts",
    "test:database-date": "node --no-warnings --experimental-strip-types --test tests/database-date.test.mts",
    "test:time-card-disconnect": "node --no-warnings --experimental-strip-types --test tests/time-card-disconnect.test.mts",
    "test:tcm-delivery": "node --no-warnings --experimental-strip-types --test tests/tcm-delivery-policy.test.mts"
  },
  "dependencies": {
    "@types/pg": "^8.20.0",
    "better-auth": "^1.5.6",
    "next": "^15.2.0",
    "pg": "^8.20.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.21.0",
    "eslint-config-next": "^15.2.0",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
